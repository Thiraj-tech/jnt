---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import ColorBar from './ColorBar.astro';
import { site, url } from '../data/site';
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <ColorBar tall />
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a class="logo" href={url('/')} aria-label="JNT Suppliers, home"><Logo label onDark /></a>
      <p class="footer-desc">{site.description}</p>
    </div>
    <div>
      <h2>Products</h2>
      <ul>{products.map((p) => <li><a href={url(`/products/${p.id}/`)}>{p.data.shortTitle}</a></li>)}</ul>
    </div>
    <div>
      <h2>Company</h2>
      <ul>
        <li><a href={url('/guides/')}>Guides</a></li>
        <li><a href={url('/about/')}>About</a></li>
        <li><a href={url('/contact/')}>Contact</a></li>
        <li><a href={site.facebook} rel="noopener">Facebook</a></li>
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={site.whatsappHref}>WhatsApp</a></li>
        <li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap site-footer__base">
    <span>© {year} {site.legalName} · Sri Lanka</span>
    <span>Pressroom chemicals for offset printing</span>
  </div>
</footer>
