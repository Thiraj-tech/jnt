---
// Printer's registration target.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['reg', cls]} viewBox="0 0 30 30" aria-hidden="true">
  <circle cx="15" cy="15" r="8" fill="none" stroke="currentColor" stroke-width="1" />
  <circle cx="15" cy="15" r="4" fill="currentColor" />
  <path d="M15 0v30M0 15h30" stroke="currentColor" stroke-width="1" />
</svg>
