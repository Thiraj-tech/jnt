---
import Logo from './Logo.astro';
import ColorBar from './ColorBar.astro';
import { site, url } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: url('/products/'), label: 'Products' },
  { href: url('/about/'), label: 'About' },
  { href: url('/contact/'), label: 'Contact' },
];
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <ColorBar />
  <div class="wrap site-header__inner">
    <a class="logo" href={url('/')} aria-label="JNT Suppliers, home">
      <Logo label />
      <span class="logo__text">Suppliers</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
      </ul>
      <a class="nav__phone" href={site.phoneHref}>{site.phoneDisplay}</a>
      <a class="btn btn--red" href={url('/contact/')}>Request a quote</a>
    </nav>
    <details class="menu">
      <summary><span class="menu__bars" aria-hidden="true"><i></i><i></i><i></i></span>Menu</summary>
      <div class="menu__panel">
        <ul>
          <li><a href={url('/')}>Home</a></li>
          {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
        </ul>
        <div class="btn-row">
          <a class="btn btn--red" href={url('/contact/')}>Request a quote</a>
          <a class="btn btn--ghost" href={site.whatsappHref}>WhatsApp</a>
        </div>
      </div>
    </details>
  </div>
</header>
