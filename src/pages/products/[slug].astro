---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import RegMark from '../../components/RegMark.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
import Faq from '../../components/Faq.astro';
import { faqsFor, faqSchema } from '../../data/faq';
import { site, url } from '../../data/site';

export async function getStaticPaths() {
  const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
  return products.map((product, i) => ({
    params: { slug: product.id },
    props: { product, others: products.filter((_, j) => j !== i) },
  }));
}

const { product, others } = Astro.props;
const { Content } = await render(product);
const d = product.data;

const questions = faqsFor(product.id);
const guides = (await getCollection('guides')).filter((g) => g.data.products.includes(product.id)).sort((a, b) => a.data.order - b.data.order);
const pageUrl = `${site.url}/products/${product.id}/`;
const productImg = await getImage({ src: d.image, width: 800, format: 'webp' });
const productImgUrl = new URL(productImg.src, site.url).href;
const common = {
  category: 'Offset printing chemicals',
  brand: { '@type': 'Brand', name: site.name },
  manufacturer: { '@id': `${site.url}/#business` },
  image: productImgUrl,
};
// One Product for the family; each grade is listed as its own Product with its code as the SKU.
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${pageUrl}#product`,
  name: d.title,
  description: d.seoDescription,
  url: pageUrl,
  ...common,
  ...(d.variants.length
    ? {
        hasVariant: d.variants.map((v) => ({
          '@type': 'Product',
          name: `${d.shortTitle} ${v.code}: ${v.name}`,
          sku: v.code,
          description: v.text,
          url: `${pageUrl}#${v.code.toLowerCase()}`,
          ...common,
        })),
      }
    : {}),
};
---
<Base
  title={d.seoTitle ?? d.title}
  description={d.seoDescription}
  schema={questions.length ? [productSchema, faqSchema(questions)] : [productSchema]}
  image={d.image}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Products', path: '/products/' }, { name: d.shortTitle, path: `/products/${product.id}/` }]}
>
  <header class="page-head page-head--plain">
    <div class="wrap">
      <ol class="crumbs label">
        <li><a href={url('/')}>Home</a></li>
        <li><a href={url('/products/')}>Products</a></li>
        <li aria-current="page">{d.shortTitle}</li>
      </ol>
      <div class="sheet-top">
        <div>
          <div class="sheet-id">
            <span class="badge">Product information</span>
            {d.variants.length > 0 && <span class="label">{d.variants.map((v) => v.code).join(' · ')}</span>}
          </div>
          <h1>{d.h1 ?? d.title}</h1>
          <div class="prose"><Content /></div>
          <dl class="facts">
            <div><dt>Applications</dt><dd><ul>{d.bestFor.map((b) => <li>{b}</li>)}</ul></dd></div>
            <div><dt>Packs</dt><dd>{d.packs}</dd></div>
            <div><dt>Documents</dt><dd>{d.documents}</dd></div>
          </dl>
          <div class="btn-row">
            <a class="btn btn--red" href={url(`/contact/?product=${product.id}`)}>Request a quote</a>
            <a class="btn btn--ghost" href={site.whatsappHref}><Icon name="chat" />WhatsApp</a>
          </div>
        </div>
        <div class="sheet-top__img crop">
          <div class="halftone" aria-hidden="true"></div>
          <Image src={d.image} alt={d.imageAlt} widths={[420, 840]} sizes="(max-width: 860px) 90vw, 420px" format="webp" loading="eager" fetchpriority="high" />
          <RegMark class="sheet-reg" />
        </div>
      </div>
    </div>
  </header>

  {d.variants.length > 0 && (
    <section class="section" aria-labelledby="grades">
      <div class="wrap">
        <div class="head">
          <div>
            <p class="label eyebrow">{d.variants.length} grades</p>
            <h2 id="grades">Available grades</h2>
          </div>
          <p>For a recommendation specific to your press, plates, inks and water conditions, contact our technical team.</p>
        </div>
        <div class="variants">
          {d.variants.map((v) => (
            <article class="variant" id={v.code.toLowerCase()}>
              <span class="badge badge--red">{v.code}</span>
              <h3>{v.name}</h3>
              <p class="variant__for">Application: {v.bestFor}</p>
              <p class="mb-0">{v.text}</p>
              {v.points.length > 0 && <ul>{v.points.map((pt) => <li>{pt}</li>)}</ul>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {(d.specs.length > 0 || d.safety) && (
    <section class:list={['section', { 'section--rule': d.variants.length > 0 }]} aria-labelledby="specs">
      <div class="wrap two-col">
        <div>
          <p class="label eyebrow">Specifications</p>
          <h2 id="specs">Technical data</h2>
          {d.safety && (
            <div class="notice">
              <Icon name="flask" />
              <p><strong>Handling.</strong> {d.safety}</p>
            </div>
          )}
        </div>
        {d.specs.length > 0 && (
          <table class="spec">
            <caption class="sr-only">{d.title} specifications</caption>
            <tbody>
              {d.specs.map((s) => <tr><th scope="row">{s.label}</th><td>{s.value}</td></tr>)}
            </tbody>
          </table>
        )}
      </div>
    </section>
  )}

  {d.directions.length > 0 && (
    <section class="section section--rule" aria-labelledby="use">
      <div class="wrap">
        <p class="label eyebrow">Application</p>
        <h2 id="use">Directions for use</h2>
        <ol class="steps">
          {d.directions.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
        </ol>
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="section section--rule" aria-labelledby="guides-title">
      <div class="wrap">
        <div class="head">
          <div>
            <p class="label eyebrow">Guides</p>
            <h2 id="guides-title">Practical advice for {d.shortTitle.toLowerCase()}.</h2>
          </div>
        </div>
        <ol class="guide-list">
          {guides.map((g) => (
            <li>
              <a href={url(`/guides/${g.id}/`)}>
                <span class="guide-list__no label">Guide</span>
                <span class="guide-list__body">
                  <span class="guide-list__title">{g.data.title}</span>
                  <span class="guide-list__sum">{g.data.summary}</span>
                </span>
                <span class="catalogue__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {questions.length > 0 && <Faq items={questions} title={`Questions about ${d.shortTitle.toLowerCase()}.`} />}

  <QuoteCTA product={{ id: product.id, title: d.shortTitle }} />

  <section class="section" aria-labelledby="more">
    <div class="wrap">
      <h2 id="more">Related products</h2>
      <ul class="catalogue">
        {others.map((p) => (
          <li>
            <a href={url(`/products/${p.id}/`)}>
              <span class="catalogue__no">{p.data.codeFamily ?? ''}</span>
              <span class="catalogue__name">{p.data.shortTitle}</span>
              <span class="catalogue__sum">{p.data.summary}</span>
              <Image class="catalogue__img" src={p.data.image} alt="" widths={[104, 208]} sizes="104px" format="webp" />
              <span class="catalogue__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
