---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import InkSplash from '../components/InkSplash.astro';
import { url } from '../data/site';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="wrap">
      <p class="big-num ink-404" aria-hidden="true"><InkSplash ink="cyan" variant={1} />404</p>
      <h1>Page not found.</h1>
      <p class="lede">The page you requested has moved or is no longer available.</p>
      <div class="btn-row">
        <a class="btn btn--red" href={url('/products/')}>View products</a>
        <a class="arrow-link" href={url('/')}>Home <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>
